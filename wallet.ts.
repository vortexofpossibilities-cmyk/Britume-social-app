
import { supabase } from "./supabase";

export type WalletCategory =
  | "purchased"
  | "earned"
  | "promotional";

export type WalletBalances = Record<WalletCategory, number>;

export type WalletLedgerEntry = {
  id: number;
  transfer_id: string | null;
  category: WalletCategory;
  entry_type: string;
  amount: number;
  created_at: string;
};

export type WalletData = {
  balances: WalletBalances;
  transactions: WalletLedgerEntry[];
};

type WalletBalanceRow = {
  category: string;
  balance: number | string | null;
};

type WalletLedgerRow = {
  id: number | string;
  transfer_id: string | null;
  category: string;
  entry_type: string;
  amount: number | string;
  created_at: string;
};

const EMPTY_BALANCES: WalletBalances = {
  purchased: 0,
  earned: 0,
  promotional: 0,
};

function getClient() {
  if (!supabase) {
    throw new Error(
      "Supabase is not configured. Check your environment variables."
    );
  }

  return supabase;
}

function isWalletCategory(
  category: string
): category is WalletCategory {
  return (
    category === "purchased" ||
    category === "earned" ||
    category === "promotional"
  );
}

function safeAmount(value: number | string | null): number {
  const amount = Number(value ?? 0);

  return Number.isFinite(amount) ? amount : 0;
}

function setBalance(
  balances: WalletBalances,
  category: WalletCategory,
  amount: number
): void {
  switch (category) {
    case "purchased":
      balances.purchased = amount;
      break;

    case "earned":
      balances.earned = amount;
      break;

    case "promotional":
      balances.promotional = amount;
      break;
  }
}

export async function fetchWalletData(
  userId: string
): Promise<WalletData> {
  if (!userId) {
    throw new Error(
      "You must be signed in to view your wallet."
    );
  }

  const client = getClient();

  const [balancesResult, transactionsResult] =
    await Promise.all([
      client
        .from("wallet_balances")
        .select("category, balance")
        .eq("user_id", userId),

      client
        .from("wallet_ledger")
        .select(
          "id, transfer_id, category, entry_type, amount, created_at"
        )
        .eq("account_user_id", userId)
        .order("created_at", { ascending: false })
        .limit(20),
    ]);

  if (balancesResult.error) {
    throw balancesResult.error;
  }

  if (transactionsResult.error) {
    throw transactionsResult.error;
  }

  const balanceRows =
    (balancesResult.data ?? []) as WalletBalanceRow[];

  const ledgerRows =
    (transactionsResult.data ?? []) as WalletLedgerRow[];

  const balances: WalletBalances = {
    ...EMPTY_BALANCES,
  };

  for (const row of balanceRows) {
    if (!isWalletCategory(row.category)) {
      continue;
    }

    setBalance(
      balances,
      row.category,
      safeAmount(row.balance)
    );
  }

  const transactions: WalletLedgerEntry[] = [];

  for (const row of ledgerRows) {
    if (!isWalletCategory(row.category)) {
      continue;
    }

    transactions.push({
      id: Number(row.id),
      transfer_id: row.transfer_id,
      category: row.category,
      entry_type: row.entry_type,
      amount: safeAmount(row.amount),
      created_at: row.created_at,
    });
  }

  return {
    balances,
    transactions,
  };
}
