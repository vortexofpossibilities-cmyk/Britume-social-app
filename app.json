{
  "expo": {
    "name": "BRITUME",
    "slug": "britume",
    "scheme": "britume",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": ["expo-router", "expo-secure-store"],
    "android": {
      "package": "com.britume.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true
    }
  }
}
"plugins": [
  [
    "expo-splash-screen",
    {
      "image": "./assets/splash.png",
      "imageWidth": 280,
      "resizeMode": "contain",
      "backgroundColor": "#06152F"
    }
  ]
]
